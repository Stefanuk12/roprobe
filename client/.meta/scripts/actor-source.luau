-- Bundles the actor half of the remote spy into a Luau module that returns its
-- own source, for the main build to embed as a string: `run_on_actor` takes
-- source, not a module.

-- Dependencies
local exec = require("./helpers/exec")
local fs = require("@lune/fs")

-- Constants
local ENTRY = "src/actor/init.luau"
local CONFIG = ".meta/.darklua.actor.json"
local BUNDLE = "dist/actor-build.lua"
local OUT_DIR = ".meta/generated"
local OUT = `{OUT_DIR}/actorSource.luau`

--- The shortest long-bracket level that `source` cannot close early: the bundle
--- is free to hold `]]` or `]=]` inside a string literal of its own.
local function bracketLevel(source: string): string
    local level = 0
    while true do
        local equals = string.rep("=", level)
        if not source:find(`]{equals}]`, 1, true) then
            return equals
        end
        level += 1
    end
end

if not fs.isDir("dist") then
    fs.writeDir("dist")
end

exec("darklua", { "process", ENTRY, BUNDLE, "-c", CONFIG }, { stdio = "forward" })

local bundled = fs.readFile(BUNDLE)
local equals = bracketLevel(bundled)

if not fs.isDir(OUT_DIR) then
    fs.writeDir(OUT_DIR)
end

-- Luau swallows the newline right after the opening bracket, so the source still
-- starts at its first real line.
fs.writeFile(
    OUT,
    table.concat({
        `--- Generated by \`mise actor-source\` from \`{ENTRY}\`; do not edit.`,
        "---",
        "--- The bundled actor half of the remote spy, as the source `run_on_actor`",
        "--- compiles inside each actor's Luau VM.",
        `return [{equals}[`,
        bundled,
        `]{equals}]`,
        "",
    }, "\n")
)

print(`[actor-source] {OUT} ({#bundled} bytes)`)
